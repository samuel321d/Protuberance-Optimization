import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Circle, FancyArrowPatch, Arc, Polygon

plt.rcParams.update({"font.family": "DejaVu Sans", "font.size": 10, "mathtext.fontset": "dejavusans"})

A = np.array([-6.0, 0.0]); B = np.array([0.0, 0.0]); C = np.array([0.0, -2.5])
TCOL, CCOL, ZCOL, KCOL = "#1f5fbf", "#c62828", "#8a8a8a", "#222222"
LOADC, REACC = "#d81b60", "#2e7d32"
uAC = (C - A) / np.linalg.norm(C - A)   # eje del elemento AC (12,-5)/13

# ---------- numerical check ----------
def solve(th):
    t = np.radians(th)
    n = np.array([-np.cos(t), np.sin(t)])
    # unknowns: FAB, FAC, FBC, Bx, By, N
    M = np.zeros((6, 6)); r = np.zeros(6)
    M[0:2, 0] = (B - A) / 6; M[0:2, 1] = uAC; r[0:2] = [0, 100]
    M[2:4, 1] = -uAC; M[2:4, 2] = (B - C) / 2.5; M[2:4, 5] = n
    M[4:6, 0] = (A - B) / 6; M[4:6, 2] = (C - B) / 2.5; M[4, 3] = 1; M[5, 4] = 1
    return np.linalg.solve(M, r)

for th in [0, 10, 22.6199, 45, 77.69, 85]:
    s = solve(th)
    print(f"th={th:7.3f}  FAB={s[0]:9.2f} FAC={s[1]:9.2f} FBC={s[2]:9.2f} Bx={s[3]:8.2f} By={s[4]:9.2f} N={s[5]:9.2f}  formula FBC={100-240*np.tan(np.radians(th)):9.2f}")
th0 = np.degrees(np.arctan(100/240)); thmax = np.degrees(np.arctan(1100/240))
print("theta zero", th0, "theta max", thmax)


def arrow(ax, p, q, color, lw=2.0, ms=14, z=5):
    ax.add_patch(FancyArrowPatch(p, q, arrowstyle="-|>", mutation_scale=ms, color=color, lw=lw, zorder=z,
                                 shrinkA=0, shrinkB=0))


def pin_B(ax):
    ax.add_patch(Polygon([[0.0, 0.0], [0.35, 0.3], [0.35, -0.3]], closed=True, fc="#9ecae1", ec=KCOL, lw=1, zorder=3))
    ax.plot([0.35, 0.35], [0.55, -0.55], color=KCOL, lw=1.5)
    for y in np.linspace(-0.5, 0.5, 6):
        ax.plot([0.35, 0.5], [y, y + 0.12], color=KCOL, lw=0.8)


def roller_C(ax, th, rr=0.18, L=0.8):
    t = np.radians(th)
    n = np.array([-np.cos(t), np.sin(t)]); s = np.array([np.sin(t), np.cos(t)])
    ctr = C
    ax.add_patch(Circle(ctr, rr, fc="#9ecae1", ec=KCOL, lw=1, zorder=3))
    p0 = ctr - rr * n
    a, b = p0 - L * s, p0 + 0.8 * s
    ax.plot([a[0], b[0]], [a[1], b[1]], color=KCOL, lw=1.6, zorder=2)
    for k in np.linspace(-L + 0.1, 0.7, int(7 + 4 * (L - 0.8))):
        q = p0 + k * s
        h = q - 0.15 * n + 0.08 * s
        ax.plot([q[0], h[0]], [q[1], h[1]], color=KCOL, lw=0.8)
    return p0, s, n


def truss(ax, colors=(KCOL, KCOL, KCOL), styles=("-", "-", "-"), lw=2.5):
    for (P, Q), c, ls in zip([(A, B), (A, C), (B, C)], colors, styles):
        ax.plot([P[0], Q[0]], [P[1], Q[1]], color=c, lw=lw, ls=ls, zorder=2, solid_capstyle="round")
    for P in (A, B, C):
        ax.add_patch(Circle(P, 0.08, fc="white", ec=KCOL, lw=1.2, zorder=6))


# ================= FIG 1: DCL global =================
th = 30
fig, ax = plt.subplots(figsize=(7.2, 3.6))
truss(ax)
pin_B(ax)
p0, s, n = roller_C(ax, th, L=1.6)
# load
arrow(ax, A + [0, 0.0], A + [0, -1.3], LOADC)
ax.text(A[0] - 0.15, -0.75, "100 lb", ha="right", va="center", color=LOADC, fontsize=10, fontweight="bold")
# reactions at B: salen exactamente del nodo B
arrow(ax, B, B + [1.5, 0.0], REACC, z=8)
ax.text(1.62, 0.0, r"$B_x$", ha="left", va="center", color=REACC, fontsize=11)
arrow(ax, B, B + [0.0, 1.3], REACC, z=8)
ax.text(0.12, 1.2, r"$B_y$", ha="left", va="center", color=REACC, fontsize=11)
# reaction N_C: sobre el eje del elemento AC, saliendo de C
arrow(ax, C, C + 1.4 * uAC, REACC, z=8)
ax.text(*(C + 1.55 * uAC + [0.05, -0.05]), r"$N_C$", ha="left", va="top", color=REACC, fontsize=11)
# theta de la superficie respecto a la vertical
v0 = p0 - 1.5 * s
ax.plot([v0[0], v0[0]], [v0[1], v0[1] + 1.0], color=ZCOL, lw=0.8, ls=":")
ax.add_patch(Arc(v0, 1.6, 1.6, theta1=90 - th, theta2=90, color=KCOL, lw=0.9))
ax.text(v0[0] + 0.1, v0[1] + 0.95, r"$\theta$", fontsize=10)
# phi at A
ax.add_patch(Arc(A, 2.2, 2.2, theta1=-22.62, theta2=0, color=KCOL, lw=0.9))
ax.text(A[0] + 1.2, -0.25, r"$\varphi=22.62^\circ$", fontsize=9)
# dims
ax.annotate("", xy=(A[0], 0.75), xytext=(B[0], 0.75), arrowprops=dict(arrowstyle="<->", lw=0.8))
ax.text(-3, 0.85, "6 ft", ha="center", va="bottom")
ax.annotate("", xy=(2.3, 0), xytext=(2.3, -2.5), arrowprops=dict(arrowstyle="<->", lw=0.8))
ax.text(2.37, -1.25, "2.5 ft", ha="left", va="center")
for P, lab, off in [(A, "A", (-0.15, 0.15)), (B, "B", (-0.2, -0.3)), (C, "C", (-0.25, 0.5))]:
    ax.text(P[0] + off[0], P[1] + off[1], lab, fontsize=12, fontweight="bold", ha="center")
ax.set_xlim(-7.0, 3.1); ax.set_ylim(-4.05, 1.5); ax.set_aspect("equal"); ax.axis("off")
fig.tight_layout(); fig.savefig("fig1_dcl_global.png", dpi=220, bbox_inches="tight"); plt.close(fig)

# ================= FIG 2: DCL nodos =================
fig, axs = plt.subplots(1, 3, figsize=(7.4, 2.7))
def node_panel(ax, title, forces, lab):
    ax.add_patch(Circle((0, 0), 0.09, fc="white", ec=KCOL, lw=1.3, zorder=6))
    for d, txt, col, off in forces:
        d = np.array(d, float)
        arrow(ax, (0, 0), d, col, ms=12)
        ax.text(d[0] + off[0], d[1] + off[1], txt, color=col, fontsize=10, ha="center", va="center")
    ax.text(-0.18, 0.18, lab, fontsize=11, fontweight="bold", ha="right")
    ax.set_title(title, fontsize=10)
    ax.set_xlim(-1.45, 1.45); ax.set_ylim(-1.35, 1.35); ax.set_aspect("equal"); ax.axis("off")

u = uAC
node_panel(axs[0], "Nodo A", [((1.1, 0), r"$F_{AB}$", KCOL, (0, 0.18)),
                              (1.1 * u, r"$F_{AC}$", KCOL, (0.05, -0.25)),
                              ((0, -1.1), "100 lb", LOADC, (-0.42, 0.1))], "A")
node_panel(axs[1], r"Nodo C (rodillo)", [((0, 1.1), r"$F_{BC}$", KCOL, (0.3, 0)),
                                         (-1.1 * u, r"$F_{AC}$", KCOL, (0, 0.24)),
                                         (1.1 * u, r"$N_C$", REACC, (0.05, -0.2))], "C")
node_panel(axs[2], "Nodo B (pasador)", [((-1.1, 0), r"$F_{AB}$", KCOL, (0, 0.18)),
                                        ((0, -1.1), r"$F_{BC}$", KCOL, (0.3, 0)),
                                        ((1.1, 0), r"$B_x$", REACC, (0, 0.18)),
                                        ((0, 1.1), r"$B_y$", REACC, (0.25, 0))], "B")
fig.text(0.5, 0.02, "Fuerzas de elemento dibujadas saliendo del nodo (tensión supuesta); negativo = compresión",
         ha="center", fontsize=8, color="#555")
fig.tight_layout(rect=(0, 0.05, 1, 1)); fig.savefig("fig2_dcl_nodos.png", dpi=220); plt.close(fig)

# ================= FIG 3: F_BC vs theta =================
thd = np.linspace(0, 89.0, 2000)
F = 100 - 240 * np.tan(np.radians(thd))
fig, ax = plt.subplots(figsize=(7.2, 3.9))
ax.axvspan(0, thmax, color="#e8f5e9", zorder=0)
ax.axhspan(0, 400, color="#e3ecfa", alpha=0.6, zorder=0)
ax.axhline(0, color=KCOL, lw=0.8)
ax.axhline(-1000, color=CCOL, lw=1, ls="--"); ax.axhline(1000, color=CCOL, lw=1, ls="--")
ax.axvline(90, color=ZCOL, lw=1, ls=":")
ax.plot(thd, F, color=KCOL, lw=2.2, label=r"$F_{BC}=100-240\,\tan\theta$")
ax.plot([0, 90], [240, 240], color=TCOL, lw=1.2, ls="-.", label=r"$F_{AB}=+240$ lb (T, constante)")
ax.plot([0, 90], [-260, -260], color=CCOL, lw=1.2, ls="-.", label=r"$F_{AC}=-260$ lb (C, constante)")
ax.plot([th0], [0], "o", color=KCOL, ms=6, zorder=5)
ax.annotate(fr"$F_{{BC}}=0$ en $\theta={th0:.2f}^\circ$", xy=(th0, 0), xytext=(28, 170), fontsize=9,
            arrowprops=dict(arrowstyle="->", lw=0.8))
ax.plot([thmax], [-1000], "o", color=CCOL, ms=6, zorder=5)
ax.annotate(fr"$|F_{{BC}}|=1000$ lb en $\theta={thmax:.2f}^\circ$", xy=(thmax, -1000), xytext=(40, -1330), fontsize=9,
            arrowprops=dict(arrowstyle="->", lw=0.8))
ax.plot([0], [100], "o", color=TCOL, ms=5)
ax.annotate(r"máx. tensión: 100 lb ($\theta=0^\circ$)", xy=(0, 100), xytext=(3, 330), fontsize=8.5,
            arrowprops=dict(arrowstyle="->", lw=0.7))
ax.text(91, -700, r"$\theta=90^\circ$: $F_{BC}\to-\infty$" "\n(apoyos inestables)", fontsize=8.5, ha="left", va="center")
ax.text(36, -820, "intervalo admisible (c):\n0° ≤ θ ≤ 77.69°", ha="center", fontsize=8.5, color="#2e7d32")
ax.text(1.5, -60, "Tensión ↑ / Compresión ↓", fontsize=8, color="#555", va="top")
ax.set_xlim(0, 105); ax.set_ylim(-1500, 400)
ax.set_xticks([0, 15, 22.62, 30, 45, 60, 75, 77.69, 90])
ax.set_xticklabels(["0", "15", "22.6", "30", "45", "60", "", "77.7", "90"], fontsize=8.5)
ax.set_xlabel(r"Ángulo de la superficie $\theta$ (°)")
ax.set_ylabel("Fuerza en el elemento (lb)")
ax.grid(alpha=0.25)
ax.legend(loc="lower left", fontsize=8, framealpha=0.95)
for sp in ("top", "right"): ax.spines[sp].set_visible(False)
fig.tight_layout(); fig.savefig("fig3_FBC_theta.png", dpi=220); plt.close(fig)

# ================= FIG 4: DCL final T/C =================
def member_arrows(ax, P, Q, kind, col, frac=0.16):
    L = np.linalg.norm(Q - P); e = (Q - P) / L
    for J, sgn in ((P, 1), (Q, -1)):
        a = J + sgn * e * 0.35; b = J + sgn * e * (0.35 + min(0.9, frac * L))
        if kind == "T":
            arrow(ax, a, b, col, lw=1.6, ms=11, z=7)
        elif kind == "C":
            arrow(ax, b, a, col, lw=1.6, ms=11, z=7)

cases = [(10, "θ = 10°  (θ < 22.62°)"), (th0, "θ = 22.62°"), (45, "θ = 45°  (θ > 22.62°)")]
fig, axs = plt.subplots(1, 3, figsize=(7.6, 2.25))
for ax, (thc, ttl) in zip(axs, cases):
    sol = solve(thc); FBC = sol[2]
    kBC = "0" if abs(FBC) < 1e-6 else ("T" if FBC > 0 else "C")
    cBC = {"T": TCOL, "C": CCOL, "0": ZCOL}[kBC]
    truss(ax, colors=(TCOL, CCOL, cBC), styles=("-", "-", "--" if kBC == "0" else "-"), lw=3)
    member_arrows(ax, A, B, "T", TCOL); member_arrows(ax, A, C, "C", CCOL);